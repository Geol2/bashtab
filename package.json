{
  "name": "bashtab",
  "version": "0.1.0",
  "description": "Git Bash dedicated tabbed terminal",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "build": {
    "appId": "local.gitbash-tabs",
    "productName": "Git Bash Tabs",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "renderer.js", "index.html", "style.css", "icon.ico", "node_modules/**/*"],
    "extraResources": ["fast-rc.sh"],
    "asarUnpack": ["node_modules/@lydell/**"],
    "win": { "icon": "icon.png", "signAndEditExecutable": true }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
